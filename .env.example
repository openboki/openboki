# Supabase(ローカルは`pnpm db:start`の出力、本番はプロジェクト設定から)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 公開URL(OGP・sitemap・robotsの絶対URL)。ビルド時に読む。未設定ならhttps://openboki.org。
# フォークや自前ホストでは自分のURLを設定する
# SITE_URL=https://example.org

# アクセス解析のUmami(ADR 0011)。ビルド時に読む。両方を設定したビルドだけが計測スクリプトを読み込む
# UMAMI_URL=https://stats.example.org
# UMAMI_WEBSITE_ID=
