# deploy/compose.yamlが読む値。.envに写して埋める(.envはコミットしない)。作り方はREADME.md

# 英数字だけにする(接続URLにそのまま入る)
POSTGRES_PASSWORD=
# 32文字以上
JWT_SECRET=

# ブラウザから見たKongのURL + /auth/v1
API_EXTERNAL_URL=https://api.openboki.org/auth/v1
SITE_URL=https://openboki.org

# ホスト側のポート(127.0.0.1だけで待ち受ける)
POSTGRES_PORT=5432
KONG_PORT=8100
